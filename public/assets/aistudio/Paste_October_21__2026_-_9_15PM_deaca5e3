create extension if not exists "pgcrypto";

-- =========================================================
-- ENUMS
-- =========================================================

do $$ begin
  create type public.subscription_status as enum
  ('trial','active','expired','suspended','cancelled');
exception when duplicate_object then null;
end $$;

do $$ begin
  create type public.payment_method as enum
  ('cash','mobile_money','bank','card','credit');
exception when duplicate_object then null;
end $$;

do $$ begin
  create type public.user_role as enum
  ('super_admin','business_owner','manager','accountant',
   'cashier','inventory_manager','sales_staff','hr_manager','viewer');
exception when duplicate_object then null;
end $$;

-- =========================================================
-- UPDATED_AT FUNCTION
-- =========================================================

create or replace function public.set_updated_at()
returns trigger
language plpgsql
as $$
begin
  new.updated_at = now();
  return new;
end;
$$;

-- =========================================================
-- BUSINESSES
-- =========================================================

create table if not exists public.businesses (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  business_type text,
  owner_name text,
  owner_email text,
  owner_phone text,
  logo_url text,
  address text,
  city text,
  country text default 'Somalia',
  tax_number text,
  currency text default 'USD',
  timezone text default 'Africa/Mogadishu',
  status text default 'active',
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

-- =========================================================
-- USER PROFILES
-- Supabase Auth user id = auth.users.id
-- =========================================================

create table if not exists public.user_profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  full_name text,
  phone text,
  avatar_url text,
  system_role public.user_role default 'viewer',
  is_active boolean default true,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

-- =========================================================
-- BUSINESS USERS
-- Connects Auth users to businesses
-- =========================================================

create table if not exists public.business_users (
  id uuid primary key default gen_random_uuid(),
  business_id uuid not null references public.businesses(id) on delete cascade,
  user_id uuid not null references auth.users(id) on delete cascade,
  role public.user_role not null default 'viewer',
  branch_id uuid,
  is_active boolean default true,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique(business_id, user_id)
);

-- =========================================================
-- SUBSCRIPTION PLANS
-- =========================================================

create table if not exists public.subscription_plans (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  description text,
  monthly_price numeric(12,2) default 0,
  yearly_price numeric(12,2) default 0,
  max_users integer,
  max_branches integer,
  max_products integer,
  storage_limit_mb integer,
  features jsonb default '{}'::jsonb,
  is_active boolean default true,
  created_at timestamptz default now(),
  updated_at timestamptz default now()
);

