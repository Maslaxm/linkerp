-- =========================================================

insert into storage.buckets (id, name, public)
values
  ('business-logos', 'business-logos', false),
  ('product-images', 'product-images', false),
  ('employee-photos', 'employee-photos', false),
  ('documents', 'documents', false),
  ('receipts', 'receipts', false),
  ('reports', 'reports', false),
  ('system-assets', 'system-assets', true)
on conflict (id) do nothing;

-- =========================================================
-- STORAGE SECURITY
-- First folder must contain business_id
--
-- Example:
-- business_id/products/image.jpg
-- business_id/employees/photo.jpg
-- business_id/documents/file.pdf
-- =========================================================

create policy "business users can view own storage"
on storage.objects
for select
to authenticated
using (
  bucket_id in (
    'business-logos',
    'product-images',
    'employee-photos',
    'documents',
    'receipts',
    'reports'
  )
  and (
